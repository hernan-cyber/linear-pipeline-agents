# Linear API
LINEAR_API_KEY=lin_api_xxxxx
LINEAR_TEAM_ID=

# Pipeline settings
POLL_INTERVAL=30
MAX_AGENTS=5
MAX_RETRIES=3
MIN_CARD=1
MAX_CARD=9999

# Project
GIT_BRANCH=main
PROJECT_DIR=/path/to/your/project

# Test & lint commands (run by the tester agent)
TEST_CMD="npx tsc --noEmit"
LINT_CMD="npx prettier --check 'src/**/*.ts'"

# Agent Builder: comma-separated card numbers that need agent-builder review, or empty
AGENT_BUILDER_CARDS=
